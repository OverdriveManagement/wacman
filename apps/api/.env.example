# Base Postgres (sur Railway : référence ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://wacman:wacman@localhost:5432/wacman
# Secret de signature des sessions (sur Railway : ${{secret(64)}})
SESSION_SECRET=
# Origines du front autorisées à appeler l'API en direct (assistant), séparées par des virgules
WEB_ORIGINS=https://wacman.vercel.app
# Envoi des codes de connexion (Resend)
RESEND_API_KEY=
MAIL_FROM=WacMan <wacman@votre-domaine.fr>
# Assistant Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Super-administrateur créé au premier démarrage si la base est vide
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Florent Jolivet
